# Copy this file to .env and fill in real values. .env is never committed.

# --- Supabase (shared ledger + transactional state) ---
# SUPABASE_DB_URL is the Postgres connection string SQLAlchemy uses.
#   Dashboard -> Project Settings -> Database -> Connection string (URI)
#   Then run schema.sql ONCE in the SQL Editor (Dashboard -> SQL).
# FALLBACK_TO_SQLITE=1 lets the app run on a local file for DEV ONLY -
# do not set it in production; without it the app refuses to start when
# SUPABASE_DB_URL is missing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
# FALLBACK_TO_SQLITE=1

# --- Meta WhatsApp Cloud API (conversational layer) ---
# App: https://developers.facebook.com/apps -> WhatsApp -> API Setup
META_VERIFY_TOKEN=            # any secret string you choose (webhook handshake)
META_ACCESS_TOKEN=            # WhatsApp temporary/permanent access token
META_PHONE_NUMBER_ID=         # test number from Meta Graph API explorer
META_APP_SECRET=              # App secret -> used for X-Hub-Signature-256
META_API_VERSION=v20.0
META_TEMPLATE_FLIGHT_STATUS=farebeep_flight_status   # proactive status template

# --- Messaging provider switch ---
# MESSAGING_PROVIDER=meta    (production: Meta Cloud API direct - no BSP needed)
# MESSAGING_PROVIDER=twilio  (test: Twilio WhatsApp Sandbox - current test path)
# Twilio console: https://console.twilio.com -> Account Info (SID + Auth Token),
# Messaging -> Try it out -> WhatsApp to get the sandbox number + join code.
MESSAGING_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886   # sandbox number with whatsapp: prefix

# --- Gemini 1.5 Flash (intent parsing - brain.py) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- SerpApi (Google Flights engine - search.py) ---
# Note: SerpApi does NOT support NGN (verified live). Fares are fetched in
# USD and converted to NGN with the daily live rate (open.er-api.com, free).
# FX_RATE_NGN_PER_USD is the ABSOLUTE FLOOR + offline fallback: the quoted
# rate never goes below it (13 Aug 2026 real rates: CBN ~1,360, parallel
# ~1,416-1,425 - set the floor to your risk tolerance, 1,425 protects
# against the parallel rate).
# FX_SAFETY_MARGIN: quotes use the official rate (open.er-api.com, ~CBN,
# the same basis Google Flights uses for its naira display) PLUS this buffer,
# so prices track Google closely while a naira move can't wipe the margin.
# 0.03 = official + 3%. Every FX_RATE_TTL_HOURS the worker records an
# fx_rates snapshot row so the naira trend is tracked in the DB.
SERPAPI_API_KEY=
SERPAPI_ENGINE=google_flights
SERPAPI_CURRENCY=USD
FX_RATE_NGN_PER_USD=1425
FX_SAFETY_MARGIN=0.03
FX_RATE_TTL_HOURS=12
SERPAPI_GL_REGION=ng

# --- Paystack (test mode - payments.py / the Settlement Engine) ---
# Dashboard -> Settings -> API Keys & Webhooks (Test)
# TEST mode uses api.paystack.co with a TEST secret key; swap to live keys
# to go live. The webhook URL below MUST be a public HTTPS endpoint:
#   https://<your-tunnel>/webhook/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=

# --- Business rules (Settlement Engine) ---
# The brief's formula: (Net_Fare + ARHA_MARKUP_NGN + PAYSTACK_FLAT_FEE_NAIRA)
#                        / (1 - PROCESSING_FEE_RATE)
ARHA_MARKUP_NGN=5000           # flat NGN markup (your margin per booking)
PROCESSING_FEE_RATE=0.015      # 1.5% Paystack processing fee (user-funded)
PAYSTACK_FLAT_FEE_NAIRA=100    # Paystack's fixed NGN component per charge
PAYSTACK_FEE_CAP_NAIRA=2000    # Paystack caps local fees at NGN 2,000
# ADMIN_ALERT_PHONE=           # WhatsApp number or Telegram chat_id that gets
                                # "REFUND REQUIRED" alerts (blank = log only)
BOOKING_TTL_MINUTES=10        # the 10-minute price-lock window
LEDGER_TTL_MINUTES=20         # shared-ledger freshness window
STATUS_WATCH_LEAD_HOURS=3     # status watch starts 3h before departure
STATUS_POLL_SECONDS=300       # status poll interval for the worker

# --- Aviationstack (status.py) ---
# https://aviationstack.com/dashboard -> API Access Key (free tier = 100/mo)
AVIATIONSTACK_API_KEY=
